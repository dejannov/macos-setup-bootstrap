#!/usr/bin/env bash
set -euo pipefail

if ! test -r "$HOME/Library/Application Support/com.apple.TCC/TCC.db"; then
    echo
    echo "Terminal needs Full Disk Access."
    echo
    echo "1. Open System Settings."
    echo "2. Privacy & Security → Full Disk Access."
    echo "3. Enable Terminal."
    echo "4. Quit Terminal completely."
    echo "5. Start Terminal again."
    echo "6. Re-run this script."
    exit 1
fi

# Install Xcode Command Line Tools
firstTime=1
while ! xcode-select -p >/dev/null 2>&1; do
  if [[ $firstTime -eq 1 ]]; then
    echo "Installing Xcode Command Line Tools..."
    xcode-select --install || true
    firstTime=0
  fi

  echo "Please complete the installer window (check behind Terminal)."
  sleep 5
done

# Install Homebrew
if ! command -v brew >/dev/null 2>&1; then
  echo "Installing Homebrew..."

  bash <(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)

  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  else
    echo "Homebrew installation failed."
    exit 1
  fi
fi

# Install Git CLI
if ! command -v git >/dev/null 2>&1; then
  echo "Installing git command-line client..."
  brew install git
  git --version
fi

# Install GitHub CLI
if ! command -v gh >/dev/null 2>&1; then
  echo "Installing GitHub CLI..."
  brew install gh
fi

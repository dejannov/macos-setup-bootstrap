#!/usr/bin/env bash
set -euo pipefail

# Please ensure you have an active internet connection and sufficient permissions to install software on the new machine.
# Use the following command to run this script from a remote location (without downloading it first) in order to bootstrap the MacOS installation process:
# bash <(curl -fsSL https://raw.githubusercontent.com/dejannov/macos-setup/main/bootstrap)

SETUP_DIR="$HOME/Documents/setup"

echo "Bootstrapping MacOS setup environment..."

if ! test -r "$HOME/Library/Application Support/com.apple.TCC/TCC.db"; then
    echo
    echo "Terminal needs Full Disk Access."
    echo
    echo "1. Open System Settings."
    echo "2. Privacy & Security → Full Disk Access."
    echo "3. Enable Terminal."
    echo "4. Quit Terminal completely."
    echo "5. Start Terminal again."
    echo "6. Re-run this script."
    exit 1
fi

if [[ ! -d "$SETUP_DIR/.git" ]]; then
  bash <(curl -fsSL https://raw.githubusercontent.com/dejannov/macos-setup/main/bootstrap-init)

  # Authenticate with GitHub
  if ! gh auth status >/dev/null 2>&1; then
    echo "Authenticate with GitHub..."
    gh auth login
  fi

  echo "Cloning private setup repository..."
  gh repo clone dejannov/macos-setup ~/Documents/setup
fi

echo "... MacOS setup environment is ready."

~/Documents/setup/install

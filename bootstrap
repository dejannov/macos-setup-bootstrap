#!/usr/bin/env bash
set -euo pipefail

echo "Bootstrapping MacOS environment..."

# Install Git CLI if missing
if ! xcode-select -p >/dev/null 2>&1; then
  echo "Installing Xcode Command Line Tools..."
  xcode-select --install

  echo "Please complete the installer window that has appeared (check the background for the installer)."

  until xcode-select -p >/dev/null 2>&1
  do
    sleep 5
    echo "Waiting for you to finish the Xcode Command Line Tools installation..."
  done

  echo "Git is now available."
fi

echo "Installing Homebrew..."
if ! command -v brew >/dev/null 2>&1; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(brew shellenv)"
fi

echo "Installing GitHub CLI..."
brew install gh

echo "Authenticate with GitHub..."
gh auth login

echo "Cloning private setup repository..."
gh repo clone dejannov/macos-setup ~/Documents/setup

~/Documents/setup/install
